use crate::{health::{Body, BodyState}, stats::CharacterStats, types::Amt};

#[derive (Debug, Clone, PartialEq, Eq)]
pub enum AgentState {
    Idle,
    Working,
    Moving,
    Sleeping,
    Combat,
    Dead,
}

pub struct Agent {
    pub id: u32,
    pub name: String,
    pub faction_id: u32,
    pub current_sector_id: u32,
    pub state: AgentState,
    pub body: Body,
    pub stats: CharacterStats,
}

impl Agent {
    pub fn tick(&mut self, delta_time: Amt) {
        if self.body.body_state == BodyState::Dead { self.state = AgentState::Dead; }
        if self.state == AgentState::Dead { return; }
        self.body.tick(delta_time);
    }
}
