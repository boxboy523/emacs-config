        public static void Csvtimer_Tick(object sender, EventArgs e)
        {
            for (int i = 0; i < 4; i++)
            {
                plc.GetDevice(MC_ING[i], out ING_val[i]);
            }

            for (int j = 0; j < 4; j++)
            {
                if (ING_val[j] == 1 && MCT_cartNum[j] > 0)
                {
                    if (Cart_Mct_For_Robot[MCT_cartNum[j] - 1] != j + 8)
                        continue;
                    else
                    {
                        workquality = "작업중";
                        QlampColor[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]] = Color.Blue;
                        Qtext[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]] = workquality;
                        QhighlightColor[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]] = Color.WhiteSmoke;

                        csv_temp[j] = false;
                    }
                }
            }
        }

        public static void Csvtimer1_Tick(object sender, EventArgs e)
        {
            for (int i = 0; i < 4; i++)
            {
                plc.GetDevice(MC_OK[i], out OK_val[i]);
            }

            for (int j = 0; j < 4; j++)
            {
                if (OK_val[j] == 1 && !csv_temp[j] && MCT_cartNum[j] > 0)
                {
                    if (Cart_Mct_For_Robot[MCT_cartNum[j] - 1] != j + 8)
                        continue;
                    else
                    {
                        csv_temp[j] = true;
                        workquality = "양품";
                        barcode = settingtext[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]];
                        csm[j].Add(barcode, workquality, Macro_mct[j + 8], DateTime.Now.ToString());
                        csm[j].Save();
                        QlampColor[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]] = Color.Green;
                        Qtext[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]] = workquality;
                        QhighlightColor[MCT_cartNum[j] - 1, Cart_Floor[MCT_cartNum[j] - 1]] = Color.LightGreen;
                        Cart_Floor[MCT_cartNum[j] - 1]++;
                    }
                }
            }
        }

