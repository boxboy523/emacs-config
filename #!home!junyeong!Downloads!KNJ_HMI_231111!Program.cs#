            RobotNumReg_floor = RobotDataTable.AddNumReg(FRRJIf.FRIF_DATA_TYPE.NUMREG_INT, Cart_floor_NumReg[0], Cart_floor_NumReg[3]);
            RobotNumReg_size = RobotDataTable.AddNumReg(FRRJIf.FRIF_DATA_TYPE.NUMREG_REAL, Cart_size_NumReg[0], Cart_size_NumReg[3]);
            RobotNumReg_mct = RobotDataTable.AddNumReg(FRRJIf.FRIF_DATA_TYPE.NUMREG_INT, Cart_mct_NumReg[0], Cart_mct_NumReg[3]);
            RobotNumReg_cart = RobotDataTable.AddNumReg(FRRJIf.FRIF_DATA_TYPE.NUMREG_INT, MCT_outCart_NumReg[0], MCT_outCart_NumReg[3]);

            RobotConnected = RobotCore.Connect("192.168.0.1");

            #endregion

            Application.Run(context);            ///작화 프로그램 시작화면 구동함수
        }
    }
