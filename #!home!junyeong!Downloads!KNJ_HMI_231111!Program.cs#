        public static void Alarmtimer1_Tick(object sender, EventArgs e)
        {
            if (HMI.Screen_6.alarmlist_save != null)
                HMI.Screen_6.alarmlist_save = alarmlist;

            for (int i = 50; i < 71; i++)
            {
                plc.GetDevice(String.Format("M{0}", i), out M_data[i]);
            }
        }

        public static void Alarmtimer2_Tick(object sender, EventArgs e)
        {
            for (int i = 50; i < 71; i++)
            {
                if (M[i] == null)
                    continue;
                if (M_data[i] == 1 && !M_temp1[i])
                {
                    alarmlist_on_date[i] = " " + DateTime.Now.ToString("MM") + "." + DateTime.Now.ToString("dd") + " " + DateTime.Now.ToString("HH:mm") + " | ";
                    alarmlist_last.Insert(0, alarmlist_on_date[i] + M[i]);
                    alarmlist.Items.Insert(0, alarmlist_last[0]);

                    M_temp1[i] = true;
                    M_temp2[i] = true;
                }
            }

        }

        public static void Alarmtimer3_Tick(object sender, EventArgs e)
        {
            for (int i = 50; i < 71; i++)
            {
                if (M[i] == null)
                    continue;
                if (M_data[i] == 0 && M_temp2[i])
                {
                    for (int j = 0; j < alarmlist_last.Count; j++)
                    {
                        if (alarmlist.Items[j].ToString() == alarmlist_on_date[i] + M[i])
                        {
                            alarmlist_last.RemoveAt(j);
                            alarmlist.Items.RemoveAt(j);
                            alarmlist_off_date[i] = "(" + DateTime.Now.ToString("MM") + "." + DateTime.Now.ToString("dd") + " " + DateTime.Now.ToString("HH:mm)");
                            alarmlist_pre.Insert(0, alarmlist_on_date[i] + M[i] + alarmlist_off_date[i]);
                            alarmlist.Items.Insert(alarmlist_last.Count, alarmlist_pre[0]);
                        }
                    }
                    M_temp1[i] = false;
                    M_temp2[i] = false;
                }
            }
        }

        public static void alarmlist_DrawItem(object sender, DrawItemEventArgs e)
        {
            e.DrawBackground();
            if (e.Index == -1)
                return;
            if (e.Index < alarmlist_last.Count)
            {
                e.Graphics.FillRectangle(new SolidBrush(SystemColors.ControlLight), e.Bounds);
                e.Graphics.DrawString(alarmlist.Items[e.Index].ToString(), e.Font, Brushes.Red, e.Bounds, StringFormat.GenericDefault);
            }
            else
            {
                e.Graphics.FillRectangle(new SolidBrush(SystemColors.Window), e.Bounds);
                e.Graphics.DrawString(alarmlist.Items[e.Index].ToString(), e.Font, SystemBrushes.WindowText, e.Bounds, StringFormat.GenericDefault);
            }
        }

