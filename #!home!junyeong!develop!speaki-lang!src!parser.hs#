

import Data.List (isPrefixOf, isSuffixOf)
import Data.Maybe (fromJust)
import Distribution.FieldGrammar (Token')
import Data.Char (isSpace)

main :: IO()
main = do
  print (fromJust (parseNumber "흐에에엥"))

data Instruction where
  Add   :: Int -> Instruction
  Move  :: Int -> Instruction
  Print :: Instruction
  Start :: Instruction
  End   :: Instruction
  Skip  :: Instruction
  Halt  :: Instruction

data Token where
  NumT   :: Int -> Token
  AddT   :: Token
  MoveT  :: Token
  PrintT :: Token
  StartT :: Token
  EndT   :: Token
  SkipT  :: Token
  HaltT  :: Token


split :: (Char -> Bool) -> String -> [String]
split _ [] = []
split predicate str = case str of
  (x:xs) | predicate x -> split predicate xs
  _ -> let (firstWord, rest) = break (predicate) str
           in firstWord : split predicate rest

parseTokens :: [Token] -> Maybe [Instruction]
parseTokens [] = Just []
parseTokens tokens = case tokens of
  (NumT n:AddT:rest) -> (Add n :) <$> parseTokens rest
  (NumT n:MoveT:rest) -> (Move n :) <$> parseTokens rest
  (AddT:rest) -> (Add 1 :) <$> parseTokens rest
  (MoveT:rest) -> (Move 1 :) <$> parseTokens rest
  (PrintT:rest) -> (Print :) <$> parseTokens rest
  (StartT:rest) -> (Start :) <$> parseTokens rest
  (EndT:rest) -> (End :) <$> parseTokens rest
  (SkipT:rest) -> (Skip :) <$> parseTokens rest
  (HaltT:rest) -> (Halt :) <$> parseTokens rest

tokenizeLine :: [String] -> Maybe [Token]
tokenizeLine [] = Just []
tokenizeLine strs = case strs of
  ("스피키":"네르지":"마세요!":xs) -> (AddT :) <$> tokenizeLine xs  
  ("스피키":"머리":"잡아당기지":"마세요!":xs) -> (MoveT :) <$> tokenizeLine xs
  ("스피키는":"이렇게":"폭력적인":"역할이":"아니란":"말이에요!":xs) -> (PrintT :) <$> tokenizeLine xs
  ("좋아요":"좋아요":"물걸레질":"좋아요~":xs) -> (StartT :) <$> tokenizeLine xs
  ("좋아요":"좋아요":"호박이":"좋아요~":xs) -> (EndT :) <$> tokenizeLine xs
  ("좋아요":"좋아요":"숨바꼭질":"좋아요~":xs) -> (SkipT :) <$> tokenizeLine xs
  ("쪼아요!":xs) -> (HaltT :) <$> tokenizeLine xs
  (x:xs) | checkNumberFormat x ->
           parseNumber x >>= \n -> case xs of
             ("에으":rest) -> (NumT (negate n) :) <$> tokenizeLine rest
             _ -> (NumT n :) <$> tokenizeLine xs
  (x:xs) -> Nothing

parseScript :: String -> Maybe [Instruction]
parseScript str =
  tokenizeLine (split isSpace str) >>= parseTokens  

checkNumberFormat :: String -> Bool
checkNumberFormat str =
  "흐" `isPrefixOf` str &&
  "엥" `isSuffixOf` str &&
  all (== '에') middlePart
  where
    middlePart = init (drop 1 str)

parseNumber :: String -> Maybe Int
parseNumber str
  | checkNumberFormat str = Just (length str - 2)
  | otherwise = Nothing
